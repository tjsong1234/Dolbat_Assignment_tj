<?xml version="1.0"?>
<package format="3">
  <name>turtle_click_nav</name>
  <version>0.1.0</version>
  <description>Click-to-go turtlesim navigation with three communicating ROS 2 nodes.</description>
  <maintainer email="tjsong12@example.com">tjsong12</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rqt_graph</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
